{
  "name": "ai-usage-streamdeck",
  "version": "1.0.0",
  "description": "Stream Deck plugin showing Claude 5-hour and weekly usage",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"./scripts/reload.sh\"",
    "pack": "npm run build && streamdeck pack com.devbloom.ai-usage.sdPlugin --force",
    "pretest": "tsc --outDir .build --sourceMap false",
    "test": "node --test test/*.test.js",
    "test:ui": "node --test test/pi.test.mjs",
    "preview": "tsc --outDir .build --sourceMap false && node scripts/preview.mjs /tmp/preview",
    "icons": "python3 scripts/icons.py",
    "icons:codex": "node scripts/gen-codex-icons.mjs",
    "verify:live": "tsc --outDir .build --sourceMap false && node scripts/verify-live.mjs"
  },
  "dependencies": {
    "@elgato/streamdeck": "^1.3.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-typescript": "^12.1.1",
    "@tsconfig/node20": "^20.1.4",
    "@types/node": "22.x",
    "playwright": "^1.49.0",
    "rollup": "^4.28.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2"
  }
}
