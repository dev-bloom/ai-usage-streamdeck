{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "Claude Usage",
  "UUID": "com.alejo.claude-usage",
  "Version": "1.1.0.0",
  "Author": "Alejo",
  "Description": "Live Claude usage on a key: 5-hour session window, weekly cap, time to reset, and a colour-coded warning as you approach the limit. Press to peek at reset times. Includes a key that launches Claude in the focused terminal.",
  "Category": "Claude Usage",
  "CategoryIcon": "imgs/plugin/category-icon",
  "Icon": "imgs/plugin/marketplace",
  "URL": "https://github.com/",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.5"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    }
  ],
  "Nodejs": {
    "Version": "20",
    "Debug": "enabled"
  },
  "Actions": [
    {
      "Name": "Claude Usage",
      "UUID": "com.alejo.claude-usage.meter",
      "Icon": "imgs/actions/meter/icon",
      "Tooltip": "Shows your Claude 5-hour and weekly usage.",
      "PropertyInspectorPath": "ui/meter.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/meter/key",
          "TitleAlignment": "middle",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "Launch Claude",
      "UUID": "com.alejo.claude-usage.launch",
      "Icon": "imgs/actions/launch/icon",
      "Tooltip": "Types a Claude command into the focused terminal, and refuses if the focused app is not one.",
      "PropertyInspectorPath": "ui/launch.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/launch/key",
          "TitleAlignment": "middle",
          "ShowTitle": false
        }
      ]
    }
  ]
}